@baseUrl = http://localhost:3000

# =========================================================
# AUTH (tokens)
# =========================================================

### Login ADMIN
# @name loginAdmin
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "admin@helpdesk.com",
  "password": "Admin@123"
}

### Login CLIENT
# @name loginClient
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "pedro.client@helpdesk.com",
  "password": "Client@123"
}

# =========================================================
# CREATE (POST /tickets)
# =========================================================

### Criar ticket como ADMIN (201)
POST {{baseUrl}}/tickets
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
  "title": "Ticket admin",
  "description": "Criado pelo admin"
}

### Criar ticket como CLIENT (201)
# @name createTicketClient
POST {{baseUrl}}/tickets
Authorization: Bearer {{loginClient.response.body.token}}
Content-Type: application/json

{
  "title": "Ticket client",
  "description": "Criado para testar permissões"
}

### Criar ticket sem title (400)
POST {{baseUrl}}/tickets
Authorization: Bearer {{loginClient.response.body.token}}
Content-Type: application/json

{
  "description": "Sem title"
}

# =========================================================
# LIST (GET /tickets) - paginação / filtros
# =========================================================

### Listar como ADMIN (200) - deve ver todos
GET {{baseUrl}}/tickets
Authorization: Bearer {{loginAdmin.response.body.token}}

### Listar como CLIENT (200) - deve ver só os próprios
GET {{baseUrl}}/tickets
Authorization: Bearer {{loginClient.response.body.token}}

### Listar com paginação (200)
GET {{baseUrl}}/tickets?page=1&limit=2
Authorization: Bearer {{loginAdmin.response.body.token}}

### Listar com filtro status (200)
GET {{baseUrl}}/tickets?status=open
Authorization: Bearer {{loginAdmin.response.body.token}}

### Status inválido (400)
GET {{baseUrl}}/tickets?status=invalid_status
Authorization: Bearer {{loginAdmin.response.body.token}}

### Limit inválido (400)
GET {{baseUrl}}/tickets?limit=999
Authorization: Bearer {{loginAdmin.response.body.token}}

### Sem token (401)
GET {{baseUrl}}/tickets

# =========================================================
# GET BY ID (GET /tickets/:id)
# =========================================================

### Buscar ticket por id como DONO (200)
GET {{baseUrl}}/tickets/{{createTicketClient.response.body.id}}
Authorization: Bearer {{loginClient.response.body.token}}

### Buscar ticket por id como ADMIN (200)
GET {{baseUrl}}/tickets/{{createTicketClient.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.token}}

### Ticket inexistente (404)
GET {{baseUrl}}/tickets/does-not-exist
Authorization: Bearer {{loginAdmin.response.body.token}}

# =========================================================
# STATUS (PATCH /tickets/:id/status)
# =========================================================

### Atualizar status como ADMIN (200)
PATCH {{baseUrl}}/tickets/{{createTicketClient.response.body.id}}/status
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
  "status": "in_progress"
}

### Status inválido (400)
PATCH {{baseUrl}}/tickets/{{createTicketClient.response.body.id}}/status
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
  "status": "invalid_status"
}

### CLIENT tentando atualizar status (403)
PATCH {{baseUrl}}/tickets/{{createTicketClient.response.body.id}}/status
Authorization: Bearer {{loginClient.response.body.token}}
Content-Type: application/json

{
  "status": "closed"
}

